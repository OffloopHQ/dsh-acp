{
  "name": "dsh-acp",
  "version": "0.1.2",
  "private": true,
  "description": "A client-neutral Agent Client Protocol adapter for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OffloopHQ/dsh-acp.git"
  },
  "homepage": "https://github.com/OffloopHQ/dsh-acp#readme",
  "bugs": {
    "url": "https://github.com/OffloopHQ/dsh-acp/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "bundle:all": "node scripts/build-binaries.mjs",
    "check": "npm run typecheck && npm test && npm run test:release-safety && npm run build",
    "start": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:release-safety": "node scripts/test-release-safety.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.27.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
